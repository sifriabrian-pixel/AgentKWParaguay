# Claude
ANTHROPIC_API_KEY=
# Opcionales (por defecto: claude-opus-5-5, effort low)
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=

# Proveedor de WhatsApp: meta (por defecto, directo a Meta) o kapso
WHATSAPP_PROVIDER=
# ID del número (en Kapso: Phone numbers; en Meta: Configuración de la API)
WHATSAPP_PHONE_NUMBER_ID=

# --- Solo con WHATSAPP_PROVIDER=kapso ---
KAPSO_API_KEY=
# Secreto con el que Kapso firma el webhook. Inventalo (una cadena larga al azar):
# el agente lo registra solo en Kapso al arrancar. Sin esto rechaza todos los mensajes.
KAPSO_WEBHOOK_SECRET=
# Opcional: URL pública del webhook. En Railway se arma sola con el dominio del servicio.
KAPSO_WEBHOOK_URL=

# --- Solo con WHATSAPP_PROVIDER=meta ---
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Obligatorio en producción: sin esto el webhook rechaza todos los mensajes
WHATSAPP_APP_SECRET=
# 1 = no envía nada a Meta, solo loguea (pruebas locales)
WHATSAPP_DRY_RUN=

# Token de sistema del Business Manager de KW (ads_read) para resolver campañas
META_SYSTEM_TOKEN=

# Base SQLite. En Railway: montar un volumen y dejar DB_PATH vacío
# (usa $RAILWAY_VOLUME_MOUNT_PATH/kw.sqlite). Local: ./data/kw.sqlite
DB_PATH=

PORT=3000

# Panel (/kw/resumen y /kw/leads). DASHBOARD_PASSWORD = equipo de KW; ADMIN_PASSWORD = Sifer
# (además ve Salud del agente). Sin ninguna de las dos, el panel no existe.
DASHBOARD_PASSWORD=
ADMIN_PASSWORD=
