# Claude
ANTHROPIC_API_KEY=
# Opcionales (por defecto: claude-opus-5-5, effort low)
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=

# WhatsApp Cloud API (número oficial de KW Paraguay)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# 1 = no envía nada a Meta, solo loguea (pruebas locales)
WHATSAPP_DRY_RUN=

# Token de sistema del Business Manager de KW (ads_read) para resolver campañas
META_SYSTEM_TOKEN=

# Base SQLite. En Railway: montar un volumen y dejar DB_PATH vacío
# (usa $RAILWAY_VOLUME_MOUNT_PATH/kw.sqlite). Local: ./data/kw.sqlite
DB_PATH=

PORT=3000
